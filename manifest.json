{
  "manifest_version": 2,
  "name": "weclapp Textbausteine",
  "version": "1.0.0",
  "description": "Vorschläge aus der Textbaustein-Liste beim Ausfüllen des weclapp-Feldes \"Beschreibung\".",
  "icons": {
    "48": "icon.svg",
    "96": "icon.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "weclapp-textbausteine@menke-it.de",
      "strict_min_version": "115.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": ["https://*.weclapp.com/*"],
      "js": ["matcher.js", "content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": ["phrases.txt"],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  }
}
